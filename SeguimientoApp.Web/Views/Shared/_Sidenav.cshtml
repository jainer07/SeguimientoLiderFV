@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div id="layoutSidenav_nav">
    <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
        <div class="sb-sidenav-menu">
            <div class="nav">
                <div class="sb-sidenav-menu-heading">Seguimiento</div>
                <a class="nav-link @(controller == "Personas" ? "active" : "")" asp-controller="Personas" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                    Personas
                </a>
                <a class="nav-link @(controller == "Seguimientos" ? "active" : "")" asp-controller="Seguimientos" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                    Seguimiento
                </a>
            </div>
        </div>
        <div class="sb-sidenav-footer">
            <div class="small">Conectado como:</div>
            Start Bootstrap
        </div>
    </nav>
</div>
