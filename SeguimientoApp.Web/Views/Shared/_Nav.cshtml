@{
    var title = ViewData["Title"]?.ToString() ?? "Seguimiento Líder";
    var subTitle = ViewData["SubTitle"]?.ToString();
}

<nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
    <div class="d-flex align-items-center">
        <!-- Brand -->
        <a class="navbar-brand ps-3 me-2" asp-controller="Home" asp-action="Index">
            Seguimiento-Líder
        </a>

        <!-- Sidebar Toggle -->
        <button class="btn btn-link btn-sm text-white"
                id="sidebarToggle"
                title="Mostrar / ocultar menú">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <!-- Page title -->
    <div class="d-none d-md-flex flex-column text-white ms-2">
        <span class="fw-bold">@title</span>
        @if (!string.IsNullOrWhiteSpace(subTitle))
        {
            <small class="text-muted">@subTitle</small>
        }
    </div>

    <!-- Right: User menu -->
    <ul class="navbar-nav ms-auto me-3 me-lg-4">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle"
               id="navbarDropdown"
               href="#"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <i class="fas fa-user fa-fw"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                <li>
                    <a class="dropdown-item" href="#">
                        Perfil
                    </a>
                </li>
                <li>
                    <hr class="dropdown-divider" />
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        Cerrar sesión
                    </a>
                </li>
            </ul>
        </li>
    </ul>
</nav>
