@model List<SeguimientoApp.Application.DTOs.PersonaDto>

@{
    ViewData["Title"] = "Personas";
    ViewData["SubTitle"] = "Lista de personas";
}

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
            <form method="get" class="d-flex flex-wrap align-items-end gap-2 m-0">
                <div>
                    <label class="form-label mb-1">Es líder</label>
                    <select id="filtroLider" name="esLider" class="form-select form-select-sm" style="min-width: 120px;" onchange="this.form.submit()">
                        <option value="" selected="@(ViewBag.EsLider == null)">Todos</option>
                        <option value="true" selected="@(ViewBag.EsLider is bool b1 && b1)">Sí</option>
                        <option value="false" selected="@(ViewBag.EsLider is bool b2 && !b2)">No</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label mb-1">Estado</label>
                    <select id="filtroEstado" name="estado" class="form-select form-select-sm" style="min-width: 120px;" onchange="this.form.submit()">
                        <option value="" selected="@(ViewBag.Estado == null)">Todos</option>
                        <option value="true" selected="@(ViewBag.Estado is bool e1 && e1)">Activo</option>
                        <option value="false" selected="@(ViewBag.Estado is bool e2 && !e2)">Inactivo</option>
                    </select>
                </div>
            </form>
            <a class="btn btn-primary btn-sm px-4" asp-controller="Personas" asp-action="Create">
                <i class="fas fa-user-plus me-1"></i>Nuevo
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table" data-datatable data-dt='{"perPage":10,"searchable":true}'>
            <thead>
                <tr>
                    <th>Número de documento</th>
                    <th>Nombre</th>
                    <th>Celular</th>
                    <th>Es líder</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.NumeroDocumento</td>
                        <td>@p.PrimerNombre @p.SegundoNombre @p.PrimerApellido @p.SegundoApellido</td>
                        <td>@p.Celular</td>
                        <td>
                            @if (p.EsLider)
                            {
                                <span class="badge bg-info">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">No</span>
                            }
                        </td>
                        <td>
                            @if (p.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-nowrap text-center">
                            <a asp-action="Details"
                               asp-route-id="@p.IdPersona"
                               class="btn btn-outline-warning btn-sm"
                               data-bs-toggle="tooltip"
                               title="Ver detalle">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@p.IdPersona"
                               class="btn btn-outline-primary btn-sm"
                               data-bs-toggle="tooltip"
                               title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>

                            <form asp-action="ToggleEstado" asp-route-id="@p.IdPersona" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (p.Estado)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Inactivar">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" data-bs-toggle="tooltip" title="Activar">
                                        <i class="fas fa-check-circle"></i>
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
