@model List<SeguimientoApp.Application.DTOs.PersonaDto>

@{
    ViewData["Title"] = "Personas";
    ViewData["SubTitle"] = "Lista de personas";
}

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
            <form method="get" class="d-flex flex-wrap align-items-end gap-2 m-0">
                <div>
                    <label class="form-label mb-1">Es líder</label>
                    <select name="esLider" class="form-select form-select-sm" style="min-width: 120px;" onchange="this.form.submit()">
                        <option value="" selected="@(ViewBag.EsLider == null)">Todos</option>
                        <option value="true" selected="@(ViewBag.EsLider is bool b1 && b1)">Sí</option>
                        <option value="false" selected="@(ViewBag.EsLider is bool b2 && !b2)">No</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label mb-1">Estado</label>
                    <select name="estado" class="form-select form-select-sm" style="min-width: 120px;" onchange="this.form.submit()">
                        <option value="" selected="@(ViewBag.Estado == null)">Todos</option>
                        <option value="true" selected="@(ViewBag.Estado is bool e1 && e1)">Activo</option>
                        <option value="false" selected="@(ViewBag.Estado is bool e2 && !e2)">Inactivo</option>
                    </select>
                </div>
            </form>
            <a class="btn btn-primary btn-sm px-4" asp-controller="Personas" asp-action="Create">Nuevo</a>
        </div>
    </div>
    <div class="card-body">
        <table id="datatablesSimple">
            <thead>
                <tr>
                    <th>Tipo documento</th>
                    <th>Número de documento</th>
                    <th>Nombre</th>
                    <th>Celular</th>
                    <th>Es líder</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Office</th>
                    <th>Age</th>
                    <th>Start date</th>
                    <th>Salary</th>
                </tr>
            </tfoot>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.TipoDocumentoCodigo</td>
                        <td>@p.NumeroDocumento</td>
                        <td>@p.PrimerNombre @p.SegundoNombre @p.PrimerApellido @p.SegundoApellido</td>
                        <td>@p.Celular</td>
                        <td>
                            @if (p.EsLider)
                            {
                                <span class="badge bg-info">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">No</span>
                            }
                        </td>
                        <td>
                            @if (p.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.IdPersona">
                                Editar
                            </a>

                            <form asp-action="ToggleEstado" asp-route-id="@p.IdPersona" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (p.Estado)
                                {
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Inactivar</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success" type="submit">Activar</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
