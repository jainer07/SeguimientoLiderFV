@model EventoCreateDto

@{
    ViewData["Title"] = "Eventos";
    ViewData["SubTitle"] = "Crear evento";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong>Nuevo evento</strong>
            <div class="text-muted small">Completa la información y guarda</div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>

    <div class="card-body">
        <form asp-action="Create" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">

                <!-- Nombre -->
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Reunión líderes - Enero" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Tipo de evento -->
                <div class="col-md-3">
                    <label asp-for="IdTipoEventoCat" class="form-label">Tipo de evento</label>
                    <select asp-for="IdTipoEventoCat"
                            class="form-select"
                            asp-items="@(ViewBag.TiposEvento as List<SelectListItem>)">
                        <option value="0">Seleccione...</option>
                    </select>
                    <span asp-validation-for="IdTipoEventoCat" class="text-danger"></span>
                </div>

                <!-- Estado -->
                <div class="col-md-3">
                    <label asp-for="IdEstadoEventoCat" class="form-label">Estado</label>
                    <select asp-for="IdEstadoEventoCat"
                            class="form-select"
                            asp-items="@(ViewBag.EstadosEvento as List<SelectListItem>)">
                        <option value="0">Seleccione...</option>
                    </select>
                    <span asp-validation-for="IdEstadoEventoCat" class="text-danger"></span>
                </div>

                <!-- Fecha inicio -->
                <div class="col-md-3">
                    <label asp-for="FechaInicio" class="form-label">Fecha inicio</label>
                    <input asp-for="FechaInicio" class="form-control" type="date" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>

                <!-- Fecha fin -->
                <div class="col-md-3">
                    <label asp-for="FechaFin" class="form-label">Fecha fin</label>
                    <input asp-for="FechaFin" class="form-control" type="date" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>

                <!-- Lugar -->
                <div class="col-md-6">
                    <label asp-for="Lugar" class="form-label">Lugar</label>
                    <input asp-for="Lugar" class="form-control" placeholder="Ej: Sede principal / Barrio / Dirección" />
                    <span asp-validation-for="Lugar" class="text-danger"></span>
                </div>

                <!-- Observaciones -->
                <div class="col-12">
                    <label asp-for="Observaciones" class="form-label">Observaciones</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3"
                              placeholder="Notas del evento (opcional)"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Pequeño detalle UX: si el usuario pone FechaInicio y FechaFin está vacía, la igualamos
        (function () {
            const ini = document.getElementById("FechaInicio");
            const fin = document.getElementById("FechaFin");
            if (!ini || !fin) return;

            ini.addEventListener("change", function () {
                if (!fin.value) fin.value = ini.value;
            });
        })();
    </script>
}
